{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sgo-calculator.example/schema/rates.schema.json",
  "title": "Rate table for one financial year",
  "type": "object",
  "required": ["financialYear", "effectiveFrom", "effectiveTo", "dataVersion"],
  "additionalProperties": false,
  "properties": {
    "financialYear": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "effectiveFrom": { "type": "string", "format": "date" },
    "effectiveTo": { "type": "string", "format": "date" },
    "dataVersion": { "type": "string" },
    "status": { "type": "string", "enum": ["PENDING_SOURCE"] },
    "pendingSourceIssue": { "type": "string", "format": "uri" },
    "note": { "type": "string" },
    "england": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["sourceId", "unit", "ageBands", "regions"],
          "additionalProperties": false,
          "properties": {
            "sourceId": { "type": "string" },
            "unit": { "const": "weekly-pence" },
            "upliftPercent": { "type": "number" },
            "note": { "type": "string" },
            "ageBands": { "$ref": "#/definitions/ageBands" },
            "regions": {
              "type": "object",
              "required": ["london", "south-east", "rest-of-england"],
              "additionalProperties": false,
              "properties": {
                "london": { "$ref": "#/definitions/bandRates" },
                "south-east": { "$ref": "#/definitions/bandRates" },
                "rest-of-england": { "$ref": "#/definitions/bandRates" }
              }
            }
          }
        }
      ]
    },
    "wales": { "$ref": "#/definitions/flatNation" },
    "northern-ireland": { "$ref": "#/definitions/flatNation" },
    "scotland": { "$ref": "#/definitions/flatNation" }
  },
  "definitions": {
    "ageBands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "minAge", "maxAge"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "minAge": { "type": "integer", "minimum": 0, "maximum": 17 },
          "maxAge": { "type": "integer", "minimum": 0, "maximum": 17 }
        }
      }
    },
    "bandRates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "flatNation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["sourceId", "unit", "ageBands", "rates"],
          "additionalProperties": false,
          "properties": {
            "sourceId": { "type": "string" },
            "unit": { "const": "weekly-pence" },
            "upliftPercent": { "type": "number" },
            "note": { "type": "string" },
            "verify": { "type": "boolean" },
            "verifyNote": { "type": "string" },
            "ageBands": { "$ref": "#/definitions/ageBands" },
            "rates": { "$ref": "#/definitions/bandRates" }
          }
        }
      ]
    }
  }
}
