{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sgo-calculator.example/schema/la-region-map.schema.json",
  "type": "object",
  "required": ["map", "names", "expectedAuthorityCount"],
  "properties": {
    "note": { "type": "string" },
    "verificationStatus": { "type": "string" },
    "verificationNote": { "type": "string" },
    "pendingSourceIssue": { "type": "string", "format": "uri" },
    "knownDiscrepancies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "mappedTo", "issue"],
        "properties": {
          "slug": { "type": "string" },
          "mappedTo": { "type": "string" },
          "issue": { "type": "string" },
          "blocks": { "type": "string" }
        }
      }
    },
    "expectedAuthorityCount": { "type": "integer", "minimum": 152 },
    "map": {
      "type": "object",
      "minProperties": 152,
      "propertyNames": { "pattern": "^[a-z0-9-]+$" },
      "additionalProperties": { "type": "string", "enum": ["london", "south-east", "rest-of-england"] }
    },
    "names": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9-]+$" },
      "additionalProperties": { "type": "string" }
    }
  }
}
