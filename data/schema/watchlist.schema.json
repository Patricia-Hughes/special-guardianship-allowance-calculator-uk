{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sgo-calculator.example/schema/watchlist.schema.json",
  "title": "Documents we are waiting on",
  "type": "object",
  "required": ["note", "items"],
  "additionalProperties": false,
  "properties": {
    "note": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "what", "why", "checkAfter", "openItem"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "what": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "url": { "type": "string" },
          "checkAfter": { "type": "string", "format": "date" },
          "openItem": { "type": "string" }
        }
      }
    }
  }
}
