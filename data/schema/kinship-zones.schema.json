{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sgo-calculator.example/schema/kinship-zones.schema.json",
  "type": "object",
  "required": ["programme", "liveFrom", "runsUntil", "localAuthorities", "eligibility", "lastVerified", "reviewEvery", "warning"],
  "properties": {
    "programme": { "type": "string" },
    "liveFrom": { "type": "string", "format": "date" },
    "runsUntil": { "type": "string" },
    "fundingFirstTwoYearsPence": { "type": "integer", "minimum": 0 },
    "approxChildren": { "type": "integer", "minimum": 0 },
    "allowanceBasis": { "type": "string" },
    "evaluator": { "type": "string" },
    "localAuthorities": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "eligibility": {
      "type": "object",
      "required": ["orderTypes", "childWouldOtherwiseBeInCare", "excludesThoseAlreadyOnReg6Support"],
      "properties": {
        "orderTypes": { "type": "array", "items": { "type": "string" } },
        "childWouldOtherwiseBeInCare": { "type": "boolean" },
        "excludesThoseAlreadyOnReg6Support": { "type": "boolean" }
      }
    },
    "lastVerified": { "type": "string", "format": "date" },
    "reviewEvery": { "type": "string", "pattern": "^P" },
    "warning": { "type": "string" }
  }
}
