{
  "name": "sgo-calculator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test:unit": "turbo run test:unit",
    "validate:data": "tsx scripts/validate-data.ts",
    "check:staleness": "tsx scripts/check-staleness.ts",
    "check:citations": "tsx scripts/check-citations.mts",
    "check:content": "tsx scripts/check-content.ts",
    "check:review-dates": "tsx scripts/check-content.ts",
    "check:headers": "tsx scripts/check-security-headers.ts",
    "check:bundle": "tsx scripts/check-bundle-budget.ts",
    "export:content": "tsx scripts/export-content-pack.ts",
    "export:readable": "tsx scripts/export-readable-site.mts",
    "export:review": "tsx scripts/export-review-pack.mts",
    "test:e2e": "pnpm --filter @sgo/web test:e2e",
    "test:a11y": "pnpm --filter @sgo/web test:a11y",
    "verify": "pnpm typecheck && pnpm test:unit && pnpm validate:data && pnpm check:staleness && pnpm check:content && pnpm check:headers",
    "export:writer": "tsx scripts/export-writer-pack.mts",
    "export:facts": "tsx scripts/export-facts-pack.mts",
    "export:content-bundle": "tsx scripts/export-content-bundle.mts",
    "export:brief": "tsx scripts/export-master-brief.mts",
    "check:schema": "tsx scripts/check-schema.ts",
    "verify:build": "pnpm build && pnpm check:bundle && pnpm check:schema"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fflate": "0.8.3",
    "parse5": "7.3.0",
    "prettier": "3.9.10",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
