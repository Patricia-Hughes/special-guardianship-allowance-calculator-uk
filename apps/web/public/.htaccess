# Apache / LiteSpeed configuration — the same contract as `_headers` and
# `_redirects`, which only Cloudflare Pages and Netlify understand.
#
# Hostinger, cPanel and most shared hosts run LiteSpeed or Apache and ignore
# those two files entirely. Without this file the site still *works* there, but
# every security header in §29.2 silently disappears and /about 404s. Both
# failures are invisible in a browser smoke test, which is exactly why this is
# committed rather than left as a deployment note.
#
# Keep the header list here in step with public/_headers.

# ---------------------------------------------------------------------------
# Security headers (§29.2)
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # `form-action 'none'` is deliberate: nothing here should ever POST anywhere.
  # There is no backend to POST to, and the day someone adds a contact form,
  # this header should be what stops them shipping it by accident.
  #
  # On 'unsafe-inline' in script-src, and why it is not laziness: Next.js ships
  # each page's data in inline <script> tags, so blocking them leaves a blank
  # page. Hashing is impractical (244 unique blocks, ~13KB of header, changing
  # every build). There is no user-generated content, no third-party script and
  # no backend here, and React escapes everything a user types — see the fuller
  # note in public/_headers, which this file must stay in step with.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://api.postcodes.io https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), interest-cohort=()"
  Header always set X-Frame-Options "DENY"
</IfModule>

# ---------------------------------------------------------------------------
# Clean URLs
# ---------------------------------------------------------------------------
# next.config.mjs sets `trailingSlash: false`, so the export writes about.html,
# not about/index.html. Apache needs telling that /about means about.html.
<IfModule mod_dir.c>
  # Off, or /guidance is an infinite redirect.
  #
  # The export writes guidance.html AND a guidance/ folder holding the sixteen
  # guides. mod_dir sees the folder, decides the canonical form of /guidance is
  # /guidance/, and issues a 301. The trailing-slash rule below then sends it
  # back to /guidance. The browser bounces between the two and gives up with
  # "redirected you too many times", which is what visitors got when they
  # clicked Guides in the menu.
  #
  # Any section that is both a page and a folder of pages hits this, so it is
  # the pattern that needs handling, not the one URL.
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One address, not four. http and https, with and without www, are four
  # different sites to a search engine, and splitting the same pages across
  # them splits whatever ranking they earn. The canonical form is https with
  # no www, which is what jsonLd.tsx, the sitemap and every canonical tag
  # already declare.
  #
  # This rule owns the www half. It writes https:// into its own target, so it
  # never has to work out whether the CURRENT request is secure, and a rule
  # that tests nothing cannot get the test wrong.
  #
  # DELIBERATELY NOT HERE: forcing http to https. That is the host's job, set
  # by the "Force HTTPS" switch in the hosting panel. Doing it here means
  # detecting the current scheme, and on a host that terminates TLS at a proxy
  # %{HTTPS} is never "on", so a rule testing it sends an already-secure
  # request to itself, forever. The host knows its own infrastructure and this
  # file does not, so the host does that half. Both halves still cost one
  # redirect each, never two for the same visitor.
  #
  # If Force HTTPS is ever switched off, plain http on the apex stops
  # redirecting. Switch it back on rather than adding a rule here.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Canonical URLs carry no trailing slash (§27). Strip it, once, with a 301.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.*)/$ /$1 [R=301,L]

  # /about -> about.html, /guidance -> guidance.html,
  # /guidance/annual-reviews -> guidance/annual-reviews.html
  #
  # Deliberately NOT guarded by !-d. The old rule skipped anything that was also
  # a directory, which is precisely how /guidance fell through to mod_dir. Where
  # a name is both a page and a folder, the page wins.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]

  # A folder with no page of its own is not browsable. With DirectorySlash off
  # this stops mod_autoindex offering a file listing, and it needs no Options
  # override, which not every shared host grants. Real files inside such a
  # folder are unaffected: they match -f above and never reach this.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{DOCUMENT_ROOT}/$1.html !-f
  RewriteRule ^(.+?)/?$ - [R=404,L]
</IfModule>

ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Everything under _next/static carries a content hash in its filename, so a
  # changed file is always a changed URL. Safe to cache for a year.
  #
  # <Directory> is NOT legal in a .htaccess file. Apache allows it only in the
  # server config or a virtual host, and finding one here is a fatal parse
  # error: the server answers every request under this directory with a 500.
  # A previous version of this file wrapped the rule below in one, which would
  # have taken the whole site down on Hostinger, cPanel and any other Apache or
  # LiteSpeed host, which is exactly what this file exists for. Only <Files>,
  # <FilesMatch>, <If> and <IfModule> may be used in here.
  #
  # So the scoping is done with mod_rewrite instead, which IS allowed, by
  # setting an environment variable on the paths that qualify. FilesMatch alone
  # cannot express "only under _next/static", and that is the whole point:
  # everything under there is content-hashed, so a changed file is a changed
  # URL, while an unhashed script at the site root frozen for a year would be
  # unfixable.
  <IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} ^/_next/static/.*\.(js|css|woff2)$
    RewriteRule .* - [E=LONGCACHE:1]
  </IfModule>

  # HTML must revalidate, or an April rate change would sit stale in caches
  # while carers read last year's figures (§9 staleness).
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>

# Cache-Control belongs to mod_headers, so it lives in its own guard. Sitting
# inside the mod_expires block above, as it used to, meant a host with
# mod_expires but not mod_headers hit an unknown directive, which is another
# 500 for the whole site.
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=LONGCACHE
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # This file is edited after upload; never freeze an old measurement ID.
  <Files "site-config.js">
    Header set Cache-Control "no-store"
  </Files>
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Serve the print-oriented .txt companions as UTF-8 rather than latin-1.
AddDefaultCharset UTF-8
